# Backend configuration. Copy this file to `.env` (in this Backend/ directory)
# and change what you need. Everything is optional: the commented-out values
# are the defaults. Relative paths are relative to Backend/.

# --- Server ------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8080
# Origins allowed to connect: a comma-separated list, or * for any origin.
# (This replaces CLIENT_URL; the original server allowed any origin anyway.)
# CORS_ALLOWED_ORIGINS=*
# DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# --- Data --------------------------------------------------------------------
# The question database. Built from QUESTIONS_CSV_PATH on startup when missing;
# rebuild it after editing the CSV: python -m tools.question_bank.build_database
# TRIVIA_DB_PATH=data/trivia.db
# QUESTIONS_CSV_PATH=data/questions.csv
# Chat messages of running games (a game's messages are deleted when it ends).
# CHAT_DB_PATH=data/chat.db
# Sound effects served at /sounds. Not in git; the game runs without them.
# SOUNDS_DIR=sounds

# --- Game timing -------------------------------------------------------------
# MATCHMAKING_SECONDS=30
# QUESTION_SECONDS=20
# QUESTIONS_PER_GAME=10

# --- Phone a friend ----------------------------------------------------------
# The "call a friend" lifeline asks an OpenAI model. Without a key the lifeline
# is given back and the player sees "Missing OPENAI_API_KEY in .env file."
OPENAI_API_KEY=
# FRIEND_MODEL=gpt-5-nano

# --- Question pipeline (tools/question_bank, never used by the server) -------
# generate_questions and dedupe_questions use OPENAI_API_KEY above;
# check_answers asks free models through OpenRouter.
OPENROUTER_API_KEY=
